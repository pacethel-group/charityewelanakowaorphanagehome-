/* Charity Ewela Nakowa Orphanage Home — site interactions */
(() => {
  'use strict';
  const $ = (selector, root = document) => root.querySelector(selector);
  const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
  const menu = $('#siteMenu'), backdrop = $('#menuBackdrop'), toggle = $('#menuToggle');
  function setMenu(open) {
    if (!menu || !backdrop || !toggle) return;
    menu.hidden = !open; backdrop.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('menu-open', open);
  }
  toggle?.addEventListener('click', () => setMenu(menu?.hidden ?? true));
  $('#menuClose')?.addEventListener('click', () => setMenu(false));
  backdrop?.addEventListener('click', () => setMenu(false));
  $$('#siteMenu a').forEach(a => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { setMenu(false); closeLightbox(); } });

  const themeToggle = $('#themeToggle');
  if (themeToggle) {
    let dark = false;
    try { dark = localStorage.getItem('cenoh-theme') === 'dark'; } catch (_) {}
    document.body.classList.toggle('dark', dark);
    const updateThemeButton = () => {
      const symbol = $('.theme-symbol', themeToggle);
      if (symbol) symbol.textContent = document.body.classList.contains('dark') ? '☀️' : '🌙';
      themeToggle.setAttribute('aria-label', document.body.classList.contains('dark') ? 'Switch to light mode' : 'Switch to dark mode');
      themeToggle.title = document.body.classList.contains('dark') ? 'Switch to light mode' : 'Switch to dark mode';
    };
    updateThemeButton();
    themeToggle.addEventListener('click', () => {
      document.body.classList.toggle('dark');
      try { localStorage.setItem('cenoh-theme', document.body.classList.contains('dark') ? 'dark' : 'light'); } catch (_) {}
      updateThemeButton();
    });
  }

  // A missing root-level file gets a clear fallback instead of an invisible/broken image.
  $$('img[data-optional-image]').forEach(img => {
    const frame = img.closest('.media-frame');
    const markLoaded = () => { frame?.classList.add('has-image'); if (frame) frame.removeAttribute('data-placeholder'); };
    img.addEventListener('load', markLoaded);
    img.addEventListener('error', () => { img.hidden = true; frame?.classList.remove('has-image'); });
    if (img.complete && img.naturalWidth) markLoaded();
  });
  $$('.gallery-video-preview').forEach(video => {
    video.addEventListener('loadedmetadata', () => video.closest('.gallery-video')?.classList.add('has-video-preview'));
    video.addEventListener('error', () => { video.hidden = true; });
  });

  const lightbox = $('#lightbox'), lightboxContent = $('#lightboxContent'), caption = $('#lightboxCaption');
  let currentIndex = -1;
  const galleryItems = () => $$('.gallery-item').filter(el => !el.hidden && getComputedStyle(el).display !== 'none');
  function openItem(item) {
    if (!lightbox || !lightboxContent || !item) return;
    lightboxContent.replaceChildren();
    const videoSrc = item.dataset.videoSrc;
    const image = $('img', item);
    if (videoSrc) {
      const video = document.createElement('video');
      video.controls = true; video.autoplay = true; video.playsInline = true; video.preload = 'metadata';
      const source = document.createElement('source'); source.src = videoSrc; source.type = 'video/mp4';
      video.append(source); lightboxContent.append(video);
      video.play().catch(() => {});
    } else {
      const src = item.dataset.gallerySrc || image?.getAttribute('src');
      if (!src) return;
      const fullImage = document.createElement('img'); fullImage.src = src; fullImage.alt = image?.alt || item.dataset.galleryTitle || 'Orphanage home gallery image';
      lightboxContent.append(fullImage);
    }
    if (caption) caption.textContent = item.dataset.galleryTitle || '';
    currentIndex = galleryItems().indexOf(item);
    lightbox.hidden = false; document.body.style.overflow = 'hidden';
    $('#lightboxClose')?.focus();
  }
  function closeLightbox() {
    if (!lightbox || lightbox.hidden) return;
    lightbox.hidden = true; lightboxContent?.replaceChildren(); document.body.style.overflow = ''; currentIndex = -1;
  }
  function moveLightbox(direction) {
    const items = galleryItems(); if (!items.length) return;
    currentIndex = (currentIndex + direction + items.length) % items.length;
    openItem(items[currentIndex]);
  }
  $$('.gallery-item').forEach(item => item.addEventListener('click', () => openItem(item)));
  $('#lightboxClose')?.addEventListener('click', closeLightbox);
  $('#lightboxPrev')?.addEventListener('click', () => moveLightbox(-1));
  $('#lightboxNext')?.addEventListener('click', () => moveLightbox(1));
  lightbox?.addEventListener('click', e => { if (e.target === lightbox) closeLightbox(); });

  $$('.filter-button').forEach(button => button.addEventListener('click', () => {
    const filter = button.dataset.filter || 'all';
    $$('.filter-button').forEach(b => { const active = b === button; b.classList.toggle('active', active); b.setAttribute('aria-pressed', String(active)); });
    $$('.gallery-item').forEach(item => { item.hidden = filter !== 'all' && item.dataset.category !== filter; });
  }));

  const toast = $('#toast'); let toastTimer;
  function showToast(message) {
    if (!toast) return;
    toast.textContent = message; toast.classList.add('show');
    clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('show'), 2400);
  }
  $$('[data-copy]').forEach(button => button.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(button.dataset.copy || ''); showToast('Copied to clipboard'); }
    catch (_) { const area = document.createElement('textarea'); area.value = button.dataset.copy || ''; document.body.append(area); area.select(); const ok = document.execCommand('copy'); area.remove(); showToast(ok ? 'Copied to clipboard' : 'Please copy the details manually'); }
  }));
  $('#currentYear') && ($('#currentYear').textContent = String(new Date().getFullYear()));
  $('#contactForm')?.addEventListener('submit', e => {
    e.preventDefault();
    const form = e.currentTarget; const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const subject = encodeURIComponent('Website enquiry — Charity Ewela Nakowa Orphanage Home');
    const body = encodeURIComponent(`Name: ${name}
Email: ${email}

${String(data.get('message') || '').trim()}`);
    const status = $('#formStatus');
    if (status) status.textContent = 'Opening your email app to send this enquiry.';
    window.location.href = `mailto:?subject=${subject}&body=${body}`;
  });
})();
